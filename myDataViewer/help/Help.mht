59pt;
 visibility:visible;mso-wrap-style:square'>
 <v:imagedata src=3D"Help_files/image037.png" o:title=3D""/>
</v:shape><![endif]--><![if !vml]><img width=3D437 height=3D212
src=3D"Help_files/image038.jpg" v:shapes=3D"Picture_x0020_3"><![endif]></sp=
an></p>

<p class=3DMsoNormal><o:p>&nbsp;</o:p></p>

<p class=3DMsoNormal><u>Comparing Data<o:p></o:p></u></p>

<p class=3DMsoNormal>This is useful to compare data from the same sensor ov=
er
different seasons. To do this check the checkbox called =93Compare Mode=94.=
 Now
every time you choose a year, month or sensor and loads its data it will be
superimposed over all the existing data. Below you can see data for the out=
side
sensor being compared for three different months. Note that we can chart da=
ta
even for incomplete months.</p>

<p class=3DMsoNormal><o:p>&nbsp;</o:p></p>

<p class=3DMsoNormal align=3Dcenter style=3D'text-align:center'><span
style=3D'mso-no-proof:yes'><!--[if gte vml 1]><v:shape id=3D"_x0000_i1031" =
type=3D"#_x0000_t75"
 style=3D'width:285.5pt;height:142pt;visibility:visible;mso-wrap-style:squa=
re'>
 <v:imagedata src=3D"Help_files/image039.png" o:title=3D""/>
</v:shape><![endif]--><![if !vml]><img width=3D381 height=3D189
src=3D"Help_files/image040.jpg" v:shapes=3D"_x0000_i1031"><![endif]></span>=
</p>

<p class=3DMsoNormal><o:p>&nbsp;</o:p></p>

<p class=3DMsoNormal>You can also compare data from different sensors in
different seasons if you so wish. </p>

<p class=3DMsoNormal><o:p>&nbsp;</o:p></p>

<p class=3DMsoNormal align=3Dcenter style=3D'text-align:center'><span
style=3D'mso-no-proof:yes'><!--[if gte vml 1]><v:shape id=3D"_x0000_i1030" =
type=3D"#_x0000_t75"
 style=3D'width:285.5pt;height:142pt;visibility:visible;mso-wrap-style:squa=
re'>
 <v:imagedata src=3D"Help_files/image041.png" o:title=3D""/>
</v:shape><![endif]--><![if !vml]><img width=3D381 height=3D189
src=3D"Help_files/image042.jpg" v:shapes=3D"_x0000_i1030"><![endif]></span>=
</p>

<p class=3DMsoNormal><o:p>&nbsp;</o:p></p>

<p class=3DMsoNormal><u>Save Chart Image<o:p></o:p></u></p>

<p class=3DMsoNormal style=3D'text-align:justify;text-justify:inter-ideogra=
ph'>Click
on the =93Save Chart Image=94 and you will be able to select where you save=
 the image
and what you call it. The size you save will depend on the size you have th=
e app
working at. For the best results maximise the app.</p>

<p class=3DMsoNormal><o:p>&nbsp;</o:p></p>

<p class=3DMsoNormal><u>Clear Chart Images<o:p></o:p></u></p>

<p class=3DMsoNormal>Click on =93Clear Chart=94 will remove the chart from =
the app. </p>

<p class=3DMsoNormal><u><o:p><span style=3D'text-decoration:none'>&nbsp;</s=
pan></o:p></u></p>

<p class=3DMsoNormal><u>Zooming into and out of the Chart<o:p></o:p></u></p>

<p class=3DMsoNormal>Zooming is useful to get deeper into the plots to chec=
k them
in more detail. There are various ways to zoom into and out of the chart.</=
p>

<p class=3DMsoNormal><o:p>&nbsp;</o:p></p>

<p class=3DMsoNormal style=3D'margin-left:36.0pt;text-indent:-18.0pt;mso-li=
st:l2 level1 lfo1'><![if !supportLists]><span
style=3D'mso-fareast-font-family:"Times New Roman"'><span style=3D'mso-list=
:Ignore'>1)<span
style=3D'font:7.0pt "Times New Roman"'>&nbsp;&nbsp;&nbsp; </span></span></s=
pan><![endif]>Check
the =93Allow Zooming=94 checkbox. You will see a =93Reset Zooming=94 button=
 now
appears.</p>

<p class=3DMsoNormal><o:p>&nbsp;</o:p></p>

<p class=3DMsoNormal align=3Dcenter style=3D'text-align:center'><span
style=3D'mso-no-proof:yes'><!--[if gte vml 1]><v:shape id=3D"_x0000_i1029" =
type=3D"#_x0000_t75"
 style=3D'width:467.5pt;height:64.5pt;visibility:visible;mso-wrap-style:squ=
are'>
 <v:imagedata src=3D"Help_files/image030.png" o:title=3D""/>
</v:shape><![endif]--><![if !vml]><img width=3D623 height=3D86
src=3D"Help_files/image043.png" v:shapes=3D"_x0000_i1029"><![endif]></span>=
</p>

<p class=3DMsoNormal><o:p>&nbsp;</o:p></p>

<p class=3DMsoNormal style=3D'margin-left:36.0pt;text-align:justify;text-ju=
stify:
inter-ideograph'>If you now place your mouse on the chart and click and hold
the left mouse button and drag the mouse and you will see a grey box appear.
This defines the area that will be zoomed in. When you let go of the left m=
ouse
button the chart will zoom in.</p>

<p class=3DMsoNormal><o:p>&nbsp;</o:p></p>

<p class=3DMsoNormal align=3Dcenter style=3D'text-align:center'><span
style=3D'mso-no-proof:yes'><!--[if gte vml 1]><v:shape id=3D"_x0000_i1028" =
type=3D"#_x0000_t75"
 style=3D'width:325pt;height:161.5pt;visibility:visible;mso-wrap-style:squa=
re'>
 <v:imagedata src=3D"Help_files/image032.png" o:title=3D""/>
</v:shape><![endif]--><![if !vml]><img width=3D433 height=3D215
src=3D"Help_files/image044.jpg" v:shapes=3D"_x0000_i1028"><![endif]></span>=
</p>

<p class=3DMsoNormal><o:p>&nbsp;</o:p></p>

<p class=3DMsoNormal style=3D'margin-left:36.0pt'>Note that you now see the=
 scrollbars
now appear for both <span class=3DGramE>axis</span>. You can zoom in as many
levels as you want by just repeating the method described above.</p>

<p class=3DMsoNormal style=3D'margin-left:36.0pt'><o:p>&nbsp;</o:p></p>

<p class=3DMsoNormal style=3D'margin-left:36.0pt'>There are several ways to=
 zoom
out. </p>

<p class=3DMsoNormal style=3D'margin-left:72.0pt;text-indent:-18.0pt;mso-li=
st:l0 level1 lfo2'><![if !supportLists]><span
style=3D'font-family:Symbol;mso-fareast-font-family:Symbol;mso-bidi-font-fa=
mily:
Symbol'><span style=3D'mso-list:Ignore'>=B7<span style=3D'font:7.0pt "Times=
 New Roman"'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
</span></span></span><![endif]>If you click the end of the scroll bar as sh=
own
in the circled in the image below you will zoom out by one level each time.=
 </p>

<p class=3DMsoNormal align=3Dcenter style=3D'text-align:center'><span
style=3D'mso-no-proof:yes'><!--[if gte vml 1]><v:shape id=3D"_x0000_i1027" =
type=3D"#_x0000_t75"
 style=3D'width:327.5pt;height:162.5pt;visibility:visible;mso-wrap-style:sq=
uare'>
 <v:imagedata src=3D"Help_files/image034.png" o:title=3D""/>
</v:shape><![endif]--><![if !vml]><img width=3D437 height=3D217
src=3D"Help_files/image045.jpg" v:shapes=3D"_x0000_i1027"><![endif]></span>=
</p>

<p class=3DMsoNormal><span style=3D'mso-spacerun:yes'>=A0</span></p>

<ul style=3D'margin-top:0cm' type=3Ddisc>
 <ul style=3D'margin-top:0cm' type=3Ddisc>
  <li class=3DMsoNormal style=3D'mso-list:l1 level2 lfo3'>Clicking on =93Re=
set Zoom=94
      will also zoom out by one level each time you click it.</li>
  <li class=3DMsoNormal style=3D'mso-list:l1 level2 lfo3'>Double Clicking t=
he left
      mouse button will also zoom out by one level each time you click it.<=
/li>
 </ul>
</ul>

<p class=3DMsoNormal><o:p>&nbsp;</o:p></p>

<p class=3DMsoNormal style=3D'margin-left:36.0pt;text-indent:-18.0pt;mso-li=
st:l2 level1 lfo1'><![if !supportLists]><span
style=3D'mso-fareast-font-family:"Times New Roman"'><span style=3D'mso-list=
:Ignore'>2)<span
style=3D'font:7.0pt "Times New Roman"'>&nbsp;&nbsp;&nbsp; </span></span></s=
pan><![endif]>You
can also use the mouse wheel to scroll zoom in and out. This works
independently of the Allow Zoom Checkbox state. The behaviours of this way =
of
zooming are different to that described above: <span
style=3D'mso-spacerun:yes'>=A0</span></p>

<p class=3DMsoNormal style=3D'margin-left:72.0pt;text-indent:-18.0pt;mso-li=
st:l3 level1 lfo4'><![if !supportLists]><span
style=3D'font-family:Symbol;mso-fareast-font-family:Symbol;mso-bidi-font-fa=
mily:
Symbol'><span style=3D'mso-list:Ignore'>=B7<span style=3D'font:7.0pt "Times=
 New Roman"'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
</span></span></span><![endif]>Moving wheel scroll </p>

<p class=3DMsoNormal style=3D'margin-left:108.0pt;text-indent:-18.0pt;mso-l=
ist:
l3 level2 lfo4'><![if !supportLists]><span style=3D'font-family:"Courier Ne=
w";
mso-fareast-font-family:"Courier New"'><span style=3D'mso-list:Ignore'>o<sp=
an
style=3D'font:7.0pt "Times New Roman"'>&nbsp;&nbsp; </span></span></span><!=
[endif]>Forward
zooms in</p>

<p class=3DMsoNormal style=3D'margin-left:108.0pt;text-indent:-18.0pt;mso-l=
ist:
l3 level2 lfo4'><![if !supportLists]><span style=3D'font-family:"Courier Ne=
w";
mso-fareast-font-family:"Courier New"'><span style=3D'mso-list:Ignore'>o<sp=
an
style=3D'font:7.0pt "Times New Roman"'>&nbsp;&nbsp; </span></span></span><!=
[endif]>Backwards
zooms out </p>

<p class=3DMsoNormal style=3D'margin-left:72.0pt;text-indent:-18.0pt;mso-li=
st:l3 level1 lfo4'><![if !supportLists]><span
style=3D'font-family:Symbol;mso-fareast-font-family:Symbol;mso-bidi-font-fa=
mily:
Symbol'><span style=3D'mso-list:Ignore'>=B7<span style=3D'font:7.0pt "Times=
 New Roman"'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
</span></span></span><![endif]>Wheel scroll zooms both X-Axis and Y-Axis<o:=
p></o:p></p>

<p class=3DMsoNormal style=3D'margin-left:72.0pt;text-indent:-18.0pt;mso-li=
st:l3 level1 lfo4'><![if !supportLists]><span
style=3D'font-family:Symbol;mso-fareast-font-family:Symbol;mso-bidi-font-fa=
mily:
Symbol'><span style=3D'mso-list:Ignore'>=B7<span style=3D'font:7.0pt "Times=
 New Roman"'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
</span></span></span><![endif]>Control + wheel scroll zooms X-Axis<o:p></o:=
p></p>

<p class=3DMsoNormal style=3D'margin-left:72.0pt;text-indent:-18.0pt;mso-li=
st:l3 level1 lfo4'><![if !supportLists]><span
style=3D'font-family:Symbol;mso-fareast-font-family:Symbol;mso-bidi-font-fa=
mily:
Symbol'><span style=3D'mso-list:Ignore'>=B7<span style=3D'font:7.0pt "Times=
 New Roman"'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
</span></span></span><![endif]>Shift + wheel scroll Zooms Y-Axis<o:p></o:p>=
</p>

<p class=3DMsoNormal style=3D'margin-left:72.0pt;text-indent:-18.0pt;mso-li=
st:l3 level1 lfo4'><![if !supportLists]><span
style=3D'font-family:Symbol;mso-fareast-font-family:Symbol;mso-bidi-font-fa=
mily:
Symbol'><span style=3D'mso-list:Ignore'>=B7<span style=3D'font:7.0pt "Times=
 New Roman"'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
</span></span></span><![endif]>Control + Shift + wheel scroll =3D ultrafine
scrolling</p>

<p class=3DMsoNormal style=3D'margin-left:72.0pt;text-indent:-18.0pt;mso-li=
st:l3 level1 lfo4'><![if !supportLists]><span
style=3D'font-family:Symbol;mso-fareast-font-family:Symbol;mso-bidi-font-fa=
mily:
Symbol'><span style=3D'mso-list:Ignore'>=B7<span style=3D'font:7.0pt "Times=
 New Roman"'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
</span></span></span><![endif]>If the Zoom checkbox is unchecked then Double
clicking the left mouse button will reset the chart to original size.<o:p><=
/o:p></p>

<p class=3DMsoNormal><o:p>&nbsp;</o:p></p>

<p class=3DMsoNormal><u>Crosshairs<o:p></o:p></u></p>

<p class=3DMsoNormal>There are two different types of crosshairs you can us=
e. One
is static and the other when activated follows the mouse movement.</p>

<p class=3DMsoNormal><o:p>&nbsp;</o:p></p>

<p class=3DMsoNormal style=3D'margin-left:36.0pt;text-indent:-18.0pt;mso-li=
st:l4 level1 lfo5'><![if !supportLists]><span
style=3D'mso-fareast-font-family:"Times New Roman"'><span style=3D'mso-list=
:Ignore'>1)<span
style=3D'font:7.0pt "Times New Roman"'>&nbsp;&nbsp;&nbsp; </span></span></s=
pan><![endif]>Check
the checkbox to activate the =93Show Crosshairs=94. Now click on a point on=
 the charted
line and you will get the static red cross hairs. It will also show a toolt=
ip
if you are on a charted point. You can click at another point and the cross=
hair
will move to that point but will not move with the mouse movement. To remove
the <span class=3DGramE>crosshairs</span> uncheck the =93Show Crosshairs=94=
 checkbox.</p>

<p class=3DMsoNormal style=3D'margin-left:18.0pt'><o:p>&nbsp;</o:p></p>

<p class=3DMsoNormal align=3Dcenter style=3D'text-align:center'><span
style=3D'mso-no-proof:yes'><!--[if gte vml 1]><v:shape id=3D"_x0000_i1026" =
type=3D"#_x0000_t75"
 style=3D'width:285.5pt;height:142pt;visibility:visible;mso-wrap-style:squa=
re'>
 <v:imagedata src=3D"Help_files/image046.png" o:title=3D""/>
</v:shape><![endif]--><![if !vml]><img width=3D381 height=3D189
src=3D"Help_files/image047.jpg" v:shapes=3D"_x0000_i1026"><![endif]></span>=
</p>

<p class=3DMsoNormal><o:p>&nbsp;</o:p></p>

<p class=3DMsoNormal style=3D'margin-left:36.0pt;text-indent:-18.0pt;mso-li=
st:l4 level1 lfo5'><![if !supportLists]><span
style=3D'mso-fareast-font-family:"Times New Roman"'><span style=3D'mso-list=
:Ignore'>2)<span
style=3D'font:7.0pt "Times New Roman"'>&nbsp;&nbsp;&nbsp; </span></span></s=
pan><![endif]>If
the =93Show Crosshairs=94 checkbox is unchecked and you left click on the c=
hart
then you will get the movable crosshairs. There will also be a tooltip show=
ing the
value of that point even if it not on a charted line. The crosshairs will
follow your mouse movements which will allow you to follow the charted line=
s.
To remove the crosshair just right click your mouse.</p>

<p class=3DMsoNormal style=3D'margin-left:18.0pt'><o:p>&nbsp;</o:p></p>

<p class=3DMsoNormal align=3Dcenter style=3D'text-align:center'><span
style=3D'mso-no-proof:yes'><!--[if gte vml 1]><v:shape id=3D"Picture_x0020_=
1"
 o:spid=3D"_x0000_i1025" type=3D"#_x0000_t75" style=3D'width:285.5pt;height=
:142pt;
 visibility:visible;mso-wrap-style:square'>
 <v:imagedata src=3D"Help_files/image048.png" o:title=3D""/>
</v:shape><![endif]--><![if !vml]><img width=3D381 height=3D189
src=3D"Help_files/image049.jpg" v:shapes=3D"Picture_x0020_1"><![endif]></sp=
an></p>

<p class=3DMsoNormal align=3Dcenter style=3D'text-align:center'><o:p>&nbsp;=
</o:p></p>

